<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GlobalPulse.Camera</AssemblyName>
    <Product>Global Pulse</Product>
    <Company>Dietrich AI Labs</Company>
    <Version>0.1.1</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="../../global_pulse/resources/context_cameras.json" LogicalName="GlobalPulse.Camera.camera_catalog.json" />
    <EmbeddedResource Include="player_view.js" LogicalName="GlobalPulse.Camera.player_view.js" />
  </ItemGroup>
</Project>
